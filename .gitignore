out
.nuxt
dist
.cache/
.vuepress/dist
.serverless/
.fusebox/
.dynamodb/
.tern-port
.vscode-test
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# ============================================================================
# Docker & Containers
# ============================================================================
# Don't ignore Dockerfiles, but ignore Docker Compose overrides
docker-compose.override.yml
docker-compose.*.override.yml
.docker/
*.tar
*.tar.gz

# ============================================================================
# Database
# ============================================================================
*.db
*.sqlite
*.sqlite3
db.sqlite3
db.sqlite3-journal
*.sql
!schema.sql
!migrations/*.sql

# ============================================================================
# Logs
# ============================================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*
*.log.*
*.log.gz

# ============================================================================
# Temporary & Build Artifacts
# ============================================================================
tmp/
temp/
.tmp/
.temp/
*.tmp
*.bak
*.swp
*.swo
*.orig
*.rej
.cache/
scratch/
playground/
test-output/

# Build outputs
dist/
build/
out/
target/
*.whl
*.egg

# ============================================================================
# Testing
# ============================================================================
.tox/
.pytest_cache/
.coverage
coverage/
htmlcov/
.nyc_output/
test-results/
test-output/
*.test
*.spec.js.snap

# ============================================================================
# CI/CD
# ============================================================================
# Keep GitHub Actions workflows
!.github/workflows/

# Azure DevOps
.azuredevops/

# Jenkins
.jenkins/

# ============================================================================
# Documentation Build
# ============================================================================
site/
_site/
.jekyll-cache/
.jekyll-metadata
mkdocs/site/
Gemfile.lock

# ============================================================================
# Infrastructure Specific
# ============================================================================
# Script outputs
scripts/*.output
scripts/*.log
scripts/temp/

# Deployment artifacts
deploy-output/
deployment-logs/

# Generated configuration
*-generated.json
*-generated.yaml
*-generated.yml

# Backup files
*.backup
backups/

# ============================================================================
# Application Specific
# ============================================================================
# Sample app artifacts (let sample-app/.gitignore handle its own)
# But ignore any generated outputs at root level
sample-app/dist/
sample-app/build/

# Frontend build artifacts (when created)
frontend/build/
frontend/dist/
frontend/.next/

# Backend artifacts (when created)
backend/dist/
backend/.eggs/
backend/*.egg-info/

# ============================================================================
# Monitoring & Observability
# ============================================================================
# Local monitoring data
monitoring/data/
*.prof
*.trace

# ============================================================================
# Security & Compliance
# ============================================================================
# Security scan results
security-scan-results/
vulnerability-reports/
*.sarif

# Audit logs (keep in Azure, not in repo)
audit-logs/

# ============================================================================
# Miscellaneous
# ============================================================================
# Archives
*.zip
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.tar.gz
*.tgz
!docs/**/*.zip
!docs/**/*.tar.gz

# Package files (keep package.json, requirements.txt)
package-lock.json
yarn.lock
pnpm-lock.yaml
Pipfile.lock
poetry.lock

# OS-specific
.DS_Store
Thumbs.db

# Editor backups
*.bak
*.gho
*.ori
*.orig
*.tmp

# ============================================================================
# Keep These Files (Explicit Exceptions)
# ============================================================================
# Always keep README files
!README.md
!**/README.md

# Keep example/template files
!*.example
!*.template
!*.sample

# Keep documentation
!docs/**/*.md
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.svg

# Keep configuration templates
!config/*.example.json
!config/*.template.json

# Keep CI/CD workflows
!.github/workflows/*.yml
!.github/workflows/*.yaml

# Keep Dockerfiles
!**/Dockerfile
!**/Dockerfile.*

# Keep infrastructure as code
!**/*.bicep
!**/*.tf
!**/*.yaml
!**/*.yml
!scripts/*.sh

# ============================================================================
# End of .gitignore
# ============================================================================
