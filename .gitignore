# ============================================================================
# Platform NBRLY - Root .gitignore
# Azure Container Apps Infrastructure Repository
# ============================================================================

# ============================================================================
# Azure & Cloud
# ============================================================================
.azure/
*.azureauth
azureprofile.json
.azcli/
*.publishsettings

# Azure Functions (if added)
local.settings.json
__blobstorage__/
__queuestorage__/
__azurite_db*__.json

# Terraform (if migrating to Terraform)
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform/
.terraform.lock.hcl
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Crossplane (future migration)
crossplane.lock
.crossplane/

# ============================================================================
# Environment & Configuration
# ============================================================================
.env
.env.*
!.env.example
!.env.template
*.local
.envrc

# Sensitive configuration files (keep templates)
config/*-local.json
config/*-override.json
config/parameters-*.json

# ============================================================================
# Azure Credentials (Service Principal & Authentication)
# ============================================================================
# Exclude all credential files - NEVER commit any files in creds/
creds/*
creds/**/*
*.cred
*.credentials
*.json
creds/*.cred
creds/*.json

# But keep documentation and templates
!creds/.gitkeep
!creds/README.md
!creds/*.example.json

# Alternative credential formats
*.credentials
*.azurecreds
*-credentials.json
*-creds.json
!config/parameters-*.json.example
!config/parameters-dev.json

# Secrets and credentials
secrets/
credentials/
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.credentials
service-account.json
*.serviceaccount

# ============================================================================
# IDE & Editors
# ============================================================================
# VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# JetBrains IDEs (IntelliJ, PyCharm, WebStorm, etc.)
.idea/
*.iml
*.ipr
*.iws
.idea_modules/
out/

# Vim
*.swp
*.swo
*~
.*.sw[a-z]
*.un~
Session.vim

# Emacs
*~
\#*\#
.#*
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# Eclipse
.project
.classpath
.settings/
.metadata
.recommenders

# TextMate
*.tmproj
*.tmproject
tmtags

# ============================================================================
# Operating Systems
# ============================================================================
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk
*.cab
*.msi
*.msix
*.msm
*.msp

# Linux
*~
.directory
.fuse_hidden*
.Trash-*
.nfs*

