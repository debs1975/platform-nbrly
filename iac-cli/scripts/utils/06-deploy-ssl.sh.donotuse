#!/bin/bash
set -e

ENVIRONMENT=${1:-dev}
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_FILE="${SCRIPT_DIR}/../config/parameters-${ENVIRONMENT}.json"
CRED_DIR="${SCRIPT_DIR}/../cred"

if [ ! -f "$CONFIG_FILE" ]; then
    echo "Infrastructure config not found: $CONFIG_FILE"
    echo "Usage: ./06-deploy-ssl.sh [dev|staging|prod]"
    exit 1
fi

# Read configuration
PROJECT_NAME=$(jq -r '.projectName' "$CONFIG_FILE")
ENV=$(jq -r '.environment' "$CONFIG_FILE")
REGION=$(jq -r '.location' "$CONFIG_FILE")
CUSTOM_DOMAIN_ENABLED=$(jq -r '.customDomain.enabled' "$CONFIG_FILE")
CUSTOM_DOMAIN=$(jq -r '.customDomain.domainName' "$CONFIG_FILE")
CERT_NAME=$(jq -r '.customDomain.certificateName' "$CONFIG_FILE")
KV_CERT_NAME=$(jq -r '.customDomain.keyVaultCertificateName' "$CONFIG_FILE")

# Enhanced: Read certificate file configuration with full path support
CERT_FILE_NAME=$(jq -r '.customDomain.certificateFileName // empty' "$CONFIG_FILE")
CERT_FILE_PATH_CONFIG=$(jq -r '.customDomain.certificateFilePath // empty' "$CONFIG_FILE")
CERT_PASSWORD_SECRET=$(jq -r '.customDomain.certificatePasswordSecret // empty' "$CONFIG_FILE")

# Resource names
RG_NAME="${PROJECT_NAME}-${ENV}-${REGION}-rg"
ENV_NAME="${PROJECT_NAME}-${ENV}-${REGION}-cae"
KEY_VAULT_NAME="${PROJECT_NAME}${ENV}${REGION}kv"

source "${SCRIPT_DIR}/helpers/azure-login.sh"
azure_login "$ENV"

echo "=========================================="
echo "Configuring Custom Domain and SSL/TLS"
echo "=========================================="
echo "Environment: ${ENV}"
echo "Container Apps Env: ${ENV_NAME}"
echo "Custom Domain: ${CUSTOM_DOMAIN}"
echo "Certificate: ${CERT_NAME}"
echo "Resource Group: ${RG_NAME}"
echo "=========================================="

if [ "$CUSTOM_DOMAIN_ENABLED" != "true" ]; then
    echo "Custom domain is not enabled in configuration."
    echo "Set customDomain.enabled to true in ${CONFIG_FILE}"
    exit 0
fi

echo ""
echo "Verifying Container Apps Environment exists..."
if ! az containerapp env show --name "$ENV_NAME" --resource-group "$RG_NAME" &>/dev/null; then
    echo "Container Apps Environment not found: $ENV_NAME"
    echo "Deploy infrastructure first: ./scripts/03-deploy-compute.sh ${ENV}"
    exit 1
fi
echo "Container Apps Environment verified"

echo ""
echo "Verifying Key Vault..."
if ! az keyvault show --name "$KEY_VAULT_NAME" --resource-group "$RG_NAME" &>/dev/null; then
    echo "Key Vault not found: $KEY_VAULT_NAME"
    echo "Deploy security infrastructure first: ./scripts/02-deploy-security.sh ${ENV}"
    exit 1
fi

echo ""
echo "Checking certificate in Key Vault..."
KV_CERT_ID=$(az keyvault certificate show \
    --vault-name "$KEY_VAULT_NAME" \
    --name "$KV_CERT_NAME" \
    --query id -o tsv 2>/dev/null || echo "")

if [ -z "$KV_CERT_ID" ]; then
    echo "Certificate '${KV_CERT_NAME}' not found in Key Vault. Attempting to upload..."
    
    # Enhanced: Determine certificate file path from config
    CERT_FILE_PATH=""
    if [ -n "$CERT_FILE_PATH_CONFIG" ]; then
        # Use full path if specified in config
        CERT_FILE_PATH="$CERT_FILE_PATH_CONFIG"
        echo "Using certificate file path from config: $CERT_FILE_PATH"
    elif [ -n "$CERT_FILE_NAME" ]; then
        # Use filename from config with cred directory
        CERT_FILE_PATH="${CRED_DIR}/${CERT_FILE_NAME}"
        echo "Using certificate file from cred directory: $CERT_FILE_PATH"
    else
        echo ""
        echo "ERROR: Certificate file not specified in configuration."
        echo "Add either 'certificateFileName' or 'certificateFilePath' to customDomain section in ${CONFIG_FILE}"
        echo ""
        echo "Example configuration (using filename):"
        echo '{'
        echo '  "customDomain": {'
        echo '    "enabled": true,'
        echo '    "domainName": "example.com",'
        echo '    "certificateName": "wildcard-cert",'
        echo '    "keyVaultCertificateName": "wildcard-cert",'
        echo '    "certificateFileName": "wildcard-example-com.pfx",'
        echo '    "certificatePasswordSecret": "cert-password"'
        echo '  }'
        echo '}'
        echo ""
        echo "Example configuration (using full path):"
        echo '{'
        echo '  "customDomain": {'
        echo '    "enabled": true,'
        echo '    "domainName": "example.com",'
        echo '    "certificateName": "wildcard-cert",'
        echo '    "keyVaultCertificateName": "wildcard-cert",'
        echo '    "certificateFilePath": "/path/to/certificates/wildcard-example-com.pfx",'
        echo '    "certificatePasswordSecret": "cert-password"'
        echo '  }'
        echo '}'
        exit 1
    fi
    
    # Check if certificate file exists
    if [ ! -f "$CERT_FILE_PATH" ]; then
        echo ""
        echo "ERROR: Certificate file not found: $CERT_FILE_PATH"
        echo ""
        if [ -n "$CERT_FILE_PATH_CONFIG" ]; then
            echo "Please ensure the certificate file exists at the specified path."
        else
            echo "Please place your certificate file in the cred directory:"
            echo " mkdir -p ${CRED_DIR}"
            echo " cp /path/to/your/${CERT_FILE_NAME} ${CERT_FILE_PATH}"
        fi
        echo ""
        echo "Supported formats: .pfx, .p12, .pem"
        exit 1
    fi
    
    echo "Found certificate file: $CERT_FILE_PATH"
    
    # Get certificate password from Key Vault if specified
    CERT_PASSWORD=""
    if [ -n "$CERT_PASSWORD_SECRET" ]; then
        echo "Retrieving certificate password from Key Vault..."
        CERT_PASSWORD=$(az keyvault secret show \
            --vault-name "$KEY_VAULT_NAME" \
            --name "$CERT_PASSWORD_SECRET" \
            --query value -o tsv 2>/dev/null || echo "")
        
        if [ -z "$CERT_PASSWORD" ]; then
            echo ""
            echo "ERROR: Certificate password secret '${CERT_PASSWORD_SECRET}' not found in Key Vault."
            echo ""
            echo "Upload the certificate password to Key Vault:"
            echo " az keyvault secret set \\"
            echo "   --vault-name ${KEY_VAULT_NAME} \\"
            echo "   --name ${CERT_PASSWORD_SECRET} \\"
            echo "   --value '<your-certificate-password>'"
            echo ""
            exit 1
        fi
        echo "Certificate password retrieved from Key Vault"
    else
        # Prompt for password if not in Key Vault
        echo ""
        read -s -p "Enter certificate password (leave empty if no password): " CERT_PASSWORD
        echo ""
    fi
    
    # Upload certificate to Key Vault
    echo "Uploading certificate to Key Vault..."
    if [ -n "$CERT_PASSWORD" ]; then
        az keyvault certificate import \
            --vault-name "$KEY_VAULT_NAME" \
            --name "$KV_CERT_NAME" \
            --file "$CERT_FILE_PATH" \
            --password "$CERT_PASSWORD" \
            --output none
    else
        az keyvault certificate import \
            --vault-name "$KEY_VAULT_NAME" \
            --name "$KV_CERT_NAME" \
            --file "$CERT_FILE_PATH" \
            --output none
    fi
    
    echo "Certificate uploaded to Key Vault: $KV_CERT_NAME"
    
    # Get the certificate ID after upload
    KV_CERT_ID=$(az keyvault certificate show \
        --vault-name "$KEY_VAULT_NAME" \
        --name "$KV_CERT_NAME" \
        --query id -o tsv)
fi

echo "Certificate verified in Key Vault: $KV_CERT_ID"

echo ""
echo "Checking if certificate already exists in Container Apps Environment..."
EXISTING_CERT=$(az containerapp env certificate list \
    --resource-group "$RG_NAME" \
    --name "$ENV_NAME" \
    --query "[?name=='${CERT_NAME}'].id" -o tsv 2>/dev/null || echo "")

if [ -z "$EXISTING_CERT" ]; then
    echo "Downloading certificate from Key Vault..."
    
    # Create temporary directory for certificate download
    TEMP_DIR=$(mktemp -d)
    TEMP_CERT_FILE="${TEMP_DIR}/${KV_CERT_NAME}.pfx"
    
    # Cleanup on exit
    trap "rm -rf $TEMP_DIR" EXIT
    
    # Download certificate from Key Vault as base64-encoded secret
    # Note: Certificates in Key Vault are stored as secrets in PFX format
    az keyvault secret download \
        --vault-name "$KEY_VAULT_NAME" \
        --name "$KV_CERT_NAME" \
        --file "$TEMP_CERT_FILE" \
        --encoding base64
    
    if [ ! -f "$TEMP_CERT_FILE" ]; then
        echo "ERROR: Failed to download certificate from Key Vault"
        exit 1
    fi
    
    echo "Certificate downloaded successfully"
    echo "Uploading certificate to Container Apps Environment..."
    
    # Upload certificate to Container Apps Environment
    # Certificates downloaded from Key Vault have empty password
    az containerapp env certificate upload \
        --resource-group "$RG_NAME" \
        --name "$ENV_NAME" \
        --certificate-file "$TEMP_CERT_FILE" \
        --certificate-name "$CERT_NAME" \
        --password "" \
        --output none
    
    echo "Certificate uploaded: $CERT_NAME"
    
    # Cleanup is handled by trap
else
    echo "Certificate already exists in environment: $CERT_NAME"
fi

echo ""
echo "Checking DNS configuration..."
echo ""

# Get Container Apps Environment static IP address
echo "Retrieving static IP address from Container Apps Environment..."
ENV_STATIC_IP=$(az containerapp env show \
    --name "$ENV_NAME" \
    --resource-group "$RG_NAME" \
    --query properties.staticIp -o tsv 2>/dev/null)

if [ -z "$ENV_STATIC_IP" ]; then
    echo "ERROR: Unable to retrieve static IP address from Container Apps Environment"
    echo "This may indicate the environment does not exist or is not properly configured"
    echo ""
    echo "Please ensure the Container Apps Environment is deployed first:"
    echo " ./scripts/03-deploy-compute.sh ${ENV}"
    echo ""
    echo "You can manually check the IP address using:"
    echo " az containerapp env show \\"
    echo "   --name ${ENV_NAME} \\"
    echo "   --resource-group ${RG_NAME} \\"
    echo "   --query properties.staticIp -o tsv"
    exit 1
fi

echo "✅ Retrieved static IP address: $ENV_STATIC_IP"

# Get domain verification ID
VERIFICATION_ID=$(az containerapp env show \
    --name "$ENV_NAME" \
    --resource-group "$RG_NAME" \
    --query properties.customDomainConfiguration.customDomainVerificationId -o tsv 2>/dev/null)

if [ -z "$VERIFICATION_ID" ]; then
    echo "WARNING: Unable to retrieve domain verification ID"
    echo "This may indicate custom domain configuration is not enabled on the environment"
    VERIFICATION_ID="<verification-id-from-azure-portal>"
fi

echo ""
echo "IMPORTANT: Before binding the custom domain, configure DNS:"
echo ""
echo "DNS Records to create:"
echo "=========================================="
echo "A Record:"
echo " Name: ${CUSTOM_DOMAIN}"
echo " Type: A"
echo " Value: ${ENV_STATIC_IP}"
echo ""
echo "TXT Record (for validation):"
echo " Name: asuid.${CUSTOM_DOMAIN}"
echo " Type: TXT"
echo " Value: ${VERIFICATION_ID}"
echo "=========================================="
echo ""

read -p "Have you configured the DNS records? (yes/no): " DNS_CONFIRMED
if [ "$DNS_CONFIRMED" != "yes" ]; then
    echo ""
    echo "Please configure DNS records and re-run this script."
    echo "Script saved DNS information above."
    exit 0
fi

echo ""
echo "Verifying DNS propagation..."
sleep 5

# Check A record
A_RECORD_IP=$(dig +short "$CUSTOM_DOMAIN" A | head -n 1)
if [ -z "$A_RECORD_IP" ]; then
    echo "WARNING: A record not found or not propagated yet."
    echo "DNS propagation can take a few minutes to several hours."
    echo ""
    read -p "Continue anyway? (yes/no): " CONTINUE
    if [ "$CONTINUE" != "yes" ]; then
        exit 0
    fi
elif [ "$A_RECORD_IP" != "$ENV_STATIC_IP" ]; then
    echo "WARNING: A record IP ($A_RECORD_IP) does not match environment static IP ($ENV_STATIC_IP)"
    echo "Please verify your DNS configuration."
    echo ""
    read -p "Continue anyway? (yes/no): " CONTINUE
    if [ "$CONTINUE" != "yes" ]; then
        exit 0
    fi
else
    echo "✅ A record verified: $CUSTOM_DOMAIN → $ENV_STATIC_IP"
fi

echo ""
echo "Adding custom domain to Container Apps Environment..."
EXISTING_DOMAIN=$(az containerapp env show \
    --name "$ENV_NAME" \
    --resource-group "$RG_NAME" \
    --query "properties.customDomainConfiguration.dnsSuffix" -o tsv 2>/dev/null || echo "")

if [ "$EXISTING_DOMAIN" == "$CUSTOM_DOMAIN" ]; then
    echo "Custom domain already configured: $CUSTOM_DOMAIN"
else
    echo "Configuring custom DNS suffix for Container Apps Environment..."
    
    # Update the environment with custom DNS suffix
    # Note: The certificate binding is automatic when the certificate exists in the environment
    az containerapp env update \
        --resource-group "$RG_NAME" \
        --name "$ENV_NAME" \
        --dns-suffix "$CUSTOM_DOMAIN" \
        --output none
    
    echo "Custom domain configured: $CUSTOM_DOMAIN"
    echo ""
    echo "Note: The certificate '$CERT_NAME' is now available for binding to individual Container Apps"
fi

echo ""
echo "=========================================="
echo "SSL/TLS Configuration Complete!"
echo "=========================================="
echo "Environment: ${ENV_NAME}"
echo "Custom Domain: ${CUSTOM_DOMAIN}"
echo "Certificate: ${CERT_NAME}"
echo ""
echo "Certificate uploaded and available in Container Apps Environment"
echo ""
echo "Next Steps:"
echo "============"
echo ""
echo "1. To bind this certificate to a Container App, use:"
echo ""
echo "   # Add custom hostname to your Container App"
echo "   az containerapp hostname add \\"
echo "     --resource-group ${RG_NAME} \\"
echo "     --name <your-app-name> \\"
echo "     --hostname <subdomain>.${CUSTOM_DOMAIN}"
echo ""
echo "   # Bind the certificate"
echo "   az containerapp hostname bind \\"
echo "     --resource-group ${RG_NAME} \\"
echo "     --name <your-app-name> \\"
echo "     --hostname <subdomain>.${CUSTOM_DOMAIN} \\"
echo "     --environment ${ENV_NAME} \\"
echo "     --thumbprint \$(az containerapp env certificate list \\"
echo "       --resource-group ${RG_NAME} \\"
echo "       --name ${ENV_NAME} \\"
echo "       --query \"[?name=='${CERT_NAME}'].properties.thumbprint\" -o tsv)"
echo ""
echo "2. Example for sample app:"
echo "   ./sample-app/scripts/bind-custom-domain.sh ${ENV} api.${CUSTOM_DOMAIN}"
echo ""
echo "3. Verify SSL certificate:"
echo "   curl -v https://<subdomain>.${CUSTOM_DOMAIN}"
echo "   openssl s_client -connect <subdomain>.${CUSTOM_DOMAIN}:443"
echo ""
echo "4. View all certificates in environment:"
echo "   az containerapp env certificate list \\"
echo "     --resource-group ${RG_NAME} \\"
echo "     --name ${ENV_NAME} \\"
echo "     --output table"
echo "=========================================="
