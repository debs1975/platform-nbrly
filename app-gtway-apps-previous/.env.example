# Azure Configuration
ACR_REGISTRY_NAME=your-acr-name
ACR_REGISTRY_URL=your-acr-name.azurecr.io
RESOURCE_GROUP=your-resource-group
SUBSCRIPTION_ID=your-subscription-id

# Deployment Configuration
ENVIRONMENT=dev
IMAGE_TAG=latest

# Container App Environments
CA_ENV_NBRLY=ca-env-nbrly-dev
CA_ENV_BLOOM=ca-env-bloom-dev

# Application Gateway Configuration
APP_GATEWAY_NAME=appgw-dev
APP_GATEWAY_RG=your-resource-group

# Domain Configuration
NBRLY_DOMAIN=nbrly-dev.astrapia.io
BLOOM_DOMAIN=bloom-dev.astrapia.io
