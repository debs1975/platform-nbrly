apiVersion: v1
kind: ConfigMap
metadata:
  name: bloom-stage-cae-routes
  namespace: default
data:
  routes.yaml: |
    routes:
      - name: bloom-stage-cae
        match:
          - path:
              value: "/app1"
              type: "PathPrefix"
        destination:
          - serviceName: ca-bloom-bmapp1-stage
            servicePort: 8000
            weight: 100
      - name: bloom-stage-cae
        match:
          - path:
              value: "/app2"
              type: "PathPrefix"
        destination:
          - serviceName: ca-bloom-bmapp2-stage
            servicePort: 8000
            weight: 100
---
# HTTP Route Config for BLOOM Container App Environment
# This configures path-based routing within the bloom-stage-cae environment
# Route FQDN: bloom-stage-cae.placeholder-stage.eastus.azurecontainerapps.io
# 
# Path routing:
# /app1 -> ca-bloom-bmapp1-stage
# /app2 -> ca-bloom-bmapp2-stage
