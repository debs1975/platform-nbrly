apiVersion: v1
kind: ConfigMap
metadata:
  name: nbrly-dev-cae-routes
  namespace: default
data:
  routes.yaml: |
    routes:
      - name: nbrly-dev-cae
        match:
          - path:
              value: "/app1"
              type: "PathPrefix"
        destination:
          - serviceName: ca-nbrly-nbapp1-dev
            servicePort: 8000
            weight: 100
      - name: nbrly-dev-cae
        match:
          - path:
              value: "/app2"
              type: "PathPrefix"
        destination:
          - serviceName: ca-nbrly-nbapp2-dev
            servicePort: 8000
            weight: 100
---
# HTTP Route Config for NBRLY Container App Environment
# This configures path-based routing within the nbrly-dev-cae environment
# Route FQDN: nbrly-dev-cae.grayfield-aa4022a1.eastus.azurecontainerapps.io
# 
# Path routing:
# /app1 -> ca-nbrly-nbapp1-dev
# /app2 -> ca-nbrly-nbapp2-dev